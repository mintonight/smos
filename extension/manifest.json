{
  "manifest_version": 3,
  "name": "SMOS · 社交媒体仅搜索",
  "short_name": "SMOS",
  "version": "1.1.0",
  "description": "把 Bilibili、抖音、知乎、小红书的首页变成仅搜索界面。",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "SMOS 设置",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.bilibili.com/",
        "*://www.bilibili.com/index.html",
        "*://www.bilibili.com/video/*",
        "*://www.bilibili.com/bangumi/play/*",
        "*://www.bilibili.com/list/*",
        "*://www.bilibili.com/medialist/play/*",
        "*://www.bilibili.com/cheese/*",
        "*://www.bilibili.com/festival/*",
        "*://www.douyin.com/*",
        "*://www.zhihu.com/*",
        "*://www.xiaohongshu.com/*"
      ],
      "js": [
        "content/05-route-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.bilibili.com/",
        "*://www.bilibili.com/index.html",
        "*://www.bilibili.com/video/*",
        "*://www.bilibili.com/bangumi/play/*",
        "*://www.bilibili.com/list/*",
        "*://www.bilibili.com/medialist/play/*",
        "*://www.bilibili.com/cheese/*",
        "*://www.bilibili.com/festival/*"
      ],
      "js": [
        "content/00-core.js",
        "content/10-bilibili.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.douyin.com/*"
      ],
      "js": [
        "content/00-core.js",
        "content/20-douyin.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.zhihu.com/*"
      ],
      "js": [
        "content/00-core.js",
        "content/30-zhihu.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.xiaohongshu.com/*"
      ],
      "js": [
        "content/00-core.js",
        "content/40-xiaohongshu.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "key": ""
}
